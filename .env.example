# Neon PostgreSQL Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
# Example: postgresql://neondb_owner:npg_abcdef123456@ep-cool-fog-a1b2c3d4-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pastebin?sslmode=prefer"

